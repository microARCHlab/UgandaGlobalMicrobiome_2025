#Tanzania analysis
#pulling the raw file from NCBI and merging into one single fastq

PRJNA=PRJEB14941
# Get sequencing run info and save onto a CSV file
esearch -db sra -query "$PRJNA" | efetch -format runinfo > Tanzania_runinfo.csv
 
# Download assembled genome data
esearch -db nucleotide -query "$PRJNA" | efetch -format fasta > Tanzaniagenomes.fa
 
# Checking how many experimental run names-ids
cat Tanzania_runinfo.csv | csvcut -c Run | wc -l
# 1119
 
# Checking the top 5 runs, using -6 because of the header
cat Tanzania_runinfo.csv | csvcut -c Run | head -6
 
# Iterate through the Accession_number.txt file and download using fastq-dump
while read -r SRR; do
  fastq-dump --split-3 "$SRR" > "$SRR"
done < Accession_number.txt
 
#merging the fastq
cat *.fastq > Tanzania.fastq



