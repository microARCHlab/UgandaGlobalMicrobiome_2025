##### UGANDAN Data Wrangling
# Importing raw data into Qiime2 using the EMP protocol for multiplexed paired-end FASTQ files

## Step 1: Import raw paired-end sequences into QZA format (Qiime2 artifact)
qiime tools import \
 --type EMPPairedEndSequences \
 --input-path Batwa-paired-end-sequences \ # Directory containing the raw sequence data
 --output-path Batwa-paired-end-sequences.qza  # Output artifact in .qza format

## Step 2: Demultiplex sequences based on barcode sequences and metadata
qiime demux emp-paired \
  --i-seqs Batwa-paired-end-sequences.qza \
  --m-barcodes-file Batwa_metadata2.txt \  # Metadata file with barcode information
  --m-barcodes-column barcode-sequence \  # Column in metadata with barcode sequences
  --o-per-sample-sequences Batwa.qza \  # Output: Demultiplexed sequences
  --o-error-correction-details Batwa-details.qza  # Output: Error correction details

## Step 3: Summarize and visualize the demultiplexed data
qiime demux summarize \
  --i-data Batwa.qza \
  --o-visualization Batwa.qzv  # Output: Visualization file

## Step 4: Quality control on sequences (filtering based on quality scores)
qiime quality-filter q-score \
  --i-demux Batwa.qza \
  --o-filtered-sequences Batwa-filtered.qza \  # Output: Filtered sequences
  --o-filter-stats Batwa-filter-stats.qza  # Output: Filtering statistics

## Step 5: Sequence denoising using Deblur (16S rRNA gene)
qiime deblur denoise-16S \
  --i-demultiplexed-seqs Batwa-filtered.qza \
  --p-trim-length 150 \  # Trim sequences to 150 bp
  --p-sample-stats \  # Output sample-level statistics
  --o-representative-sequences Batwa_rep-seqs-deblur.qza \  # Output: Representative sequences
  --o-table Batwa_table-deblur.qza \  # Output: Feature table
  --o-stats Batwa_deblur-stats.qza  # Output: Denoising statistics

## Step 6: Visualize Deblur statistics
qiime metadata tabulate \
  --m-input-file Batwa-filter-stats.qza \
  --o-visualization Batwa_demux-filter-stats.qzv  # Visualization for filter stats
qiime deblur visualize-stats \
  --i-deblur-stats Batwa_deblur-stats.qza \
  --o-visualization Batwa_deblur-stats.qzv  # Visualization for Deblur stats

## Rename intermediate files for easier access
mv Batwa_rep-seqs-deblur.qza Batwa_rep-seqs.qza
mv Batwa_table-deblur.qza Batwa_table.qza

## Step 7: Create and visualize the feature table
qiime feature-table summarize \
  --i-table Batwa_table.qza \
  --o-visualization Batwa_table.qzv \  # Visualization of feature table
  --m-sample-metadata-file Batwa_metadata2.txt  # Metadata file for mapping to the feature table
qiime feature-table tabulate-seqs \
  --i-data Batwa_rep-seqs.qza \
  --o-visualization Batwa_rep-seqs.qzv  # Visualization of representative sequences

## Step 8: Create a phylogenetic tree for downstream analyses
qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences Batwa_rep-seqs.qza \
  --output-dir Batwa_phylogeny-align-to-tree-mafft-fasttree  # Output directory for the phylogenetic tree

## Step 9: Filter out biological samples containing contaminants (e.g., EBC2A)
qiime feature-table filter-samples \
  --i-table Batwa_table.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[sample_name] IS NOT "11492.A19461.EBC2a"' \  # Remove EBC2A sample
  --o-filtered-table Filtered_Batwa_table.qza  # Output: Filtered feature table

## Step 10: Summarize the filtered feature table
qiime feature-table summarize \
  --i-table Filtered_Batwa_table.qza \
  --m-sample-metadata-file Batwa_metadata2.txt \
  --o-visualization Filtered_Batwa_table.qzv  # Visualization for the filtered table

## Step 11: Decontam process in R (external step, not in Qiime2)

## Step 12: Convert post-decontam data to BIOM format
biom convert -i SPECIES-decontam-90-11SEPT23.60.txt -o New_Batwa_6.biom --table-type="OTU table" --to-hdf5  # BIOM file conversion

## Step 13: Import the BIOM table into Qiime2 format (QZA)
qiime tools import \
  --input-path New_Batwa_6.biom \
  --type 'FeatureTable[Frequency]' \
  --input-format BIOMV210Format \
  --output-path New_Batwa_6_table.qza  # Output: Feature table in QZA format

## Step 14: Visualize the post-decontam feature table
qiime feature-table summarize \
  --i-table New_Batwa_6_table.qza \
  --o-visualization New_Batwa.biom_table_6.qzv  # Visualization for the feature table

## Step 15: Filter out control samples (EBC1, EBC2)
qiime feature-table filter-samples \
  --i-table New_Batwa_6_table.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[SampleType] IS NOT "EBC1"' \  # Filter out EBC1 control samples
  --o-filtered-table New_6_BatwaBioSamplesOnly.qza  # Output: Filtered table without EBC1

qiime feature-table filter-samples \
  --i-table New_6_BatwaBioSamplesOnly.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[SampleType] IS NOT "EBC2"' \  # Filter out EBC2 control samples
  --o-filtered-table New_6_BatwaBioSamplesOnlyfinal.qza  # Output: Final filtered table

## Step 16: Further filtering samples (PCR, specific samples)
qiime feature-table filter-samples \
  --i-table New_6_BatwaBioSamplesOnlyfinal.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[SampleType] IS NOT "PCR"' \
  --o-filtered-table New_6_no_PCR_BatwaBioSamplesOnlyfinal.qza  # Output: Filtered table without PCR

# Additional filtering to remove specific contaminated or duplicate samples
qiime feature-table filter-samples \
  --i-table New_6_no_PCR_BatwaBioSamplesOnlyfinal.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[sample_name] IS NOT "11492.A19489.TW99"' \
  --o-filtered-table New_6_no_PCR_NoTW99_BatwaBioSamplesOnlyfinal.qza  # Remove contaminated sample

qiime feature-table filter-samples \
  --i-table New_6_no_PCR_NoTW99_BatwaBioSamplesOnlyfinal.qza \
  --m-metadata-file Batwa_metadata2.txt \
  --p-where '[sample_name] IS NOT "11492.A19451.KG59e"' \
  --o-filtered-table No_duplicate_BatwaBioSamplesOnlyfinal.qza  # Remove duplicate sample

## Step 17: Filter out chloroplast and mitochondrial sequences
qiime taxa filter-table \
  --i-table New_6_no_PCR_NoTW99_NOTW51__BatwaBioSamplesOnlyfinal.qza \
  --i-taxonomy taxonomy.qza \  # Taxonomy file to identify chloroplast/mitochondria
  --p-exclude mitochondria,chloroplast \  # Exclude these taxa
  --o-filtered-table New_C_M_6_BatwaBioSamplesOnlyfinal.qza  # Output: Filtered feature table without chloroplast/mitochondria

## Step 18: Final filtering to remove features with frequency less than 5
qiime feature-table filter-features \
  --i-table New_C_M_6_BatwaBioSamplesOnlyfinal.qza \
  --p-min-frequency 5 \  # Remove features with frequency less than 5
  --o-filtered-table table_five_freq.qza  # Output: Filtered table with features >= 5

## Step 19: Summarize the final filtered table
qiime feature-table summarize \
  --i-table table_five_freq.qza \
  --m-sample-metadata-file Batwa_metadata2.txt \
  --o-visualization table_five_freq_summary.qzv  # Final visualization of the filtered feature table



