#!bin/bash
###### American Gut Project Data Wrangling - Oral Microbiome ######
# Programs and Versions
# Qiime2 v.2022.8

## User notes: Daniel McDonald updated the ftp site (http://ftp.microbio.me/AmericanGut/01jul2024-demultiplexed-data/) for the compressed QIIME sequence data artifacts (.qza) files download. In addition to the first 97 qza files shared from the previous ftp site, there are 14 more files bringing it to 112 qza files in total. Aside from the newly added qza files to the updated ftplink, the previous 97 qza files had tsv files that correspond to the run data (including sampleID, sampletype, and qiita prepID) instead of downloading all of the qza files, I checked which of the study prep files contained oral samples by greping a list of sampleID that's listed as oral samples. I then created a list of qza files contianing oral samples (curated from the metadata from Iyun) and download the data using the list as a variable via wget.

# Download qza files with list of compressed QIIME sequence data 
cat Oral_QZA.txt | while read sample; 
do
wget http://ftp.microbio.me/AmericanGut/01jul2024-demultiplexed-data/$sample
;done

# The compressed QIIME sequence data contains demultiplexed sequences already. Out of 112 available prep/qiita studies, 72 QZA files were retained with a hit for oral samples. Moved forward to filtering the sequences based on quality (the PrepNames.txt file is the same as Oral_QZA.txt, just had the extension .qza removed): 
cat PrepNames.txt | while read sample; 
do 
qiime quality-filter q-score \
    --i-demux $sample.qza \
    --o-filtered-sequences $sample-filtered.qza \
    --o-filter-stats $sample-filter-stats.qza;
done

# Have to assess if the sequences all contain 150 nt. Prep files that falls below 150 nt are exclude as oral samples from those are also below 150 nts. To do this, have to visualize the demux results by viewing the qzv files on Qiime2 View via Chrome browser:
cat PrepNames.txt | while read sample; 
do 
qiime demux summarize \
    --i-data $sample-filtered.qza\
    --o-visualization $sample-filteredqual.qzv;
done

# Once Prep files are filtered based on quality and length, moved forward with deblur to create denoised feature tables
cat PrepNames.txt | while read sample; 
do 
qiime deblur denoise-16S \
 --i-demultiplexed-seqs $sample-filtered.qza\
 --p-trim-length 150\
 --o-representative-sequences rep-seqs-deblur_$sample.qza\
 --o-table table-deblur_$sample.qza\
 --p-sample-stats \
 --o-stats deblur-stats_$sample.qza;
done

#sanity check-- check post deblur tables, I ran this in another Jupyter Noteboook window as taxonomy is still running 
%cat PrepNames.txt | while read sample; 
do
qiime feature-table summarize \
 --i-table table-deblur_$sample.qza\
 --o-visualization table-deblur_$sample.qzv;
done

# merge repseq files for taxonomy classifier trainer
qiime feature-table merge-seqs \
--i-data rep-seqs-deblur_1117-AGP3_081213_16S_NoIndex.qza \
--i-data rep-seqs-deblur_1119-AGP7_16S_NoIndex.qza \
--i-data rep-seqs-deblur_1120-Undetermined_S0_L001.qza \
--i-data rep-seqs-deblur_1121-Undetermined_S0_L001.qza \
--i-data rep-seqs-deblur_1122-Undetermined_S0_L001.qza \
--i-data rep-seqs-deblur_1123-Undetermined_S0_L001.qza \
--i-data rep-seqs-deblur_1124-Undetermined_S0_L001.qza \
