# Venezuela, AGP, Uganda, and Tanzania Microbiome Data Analysis Script
# This script uses QIIME 2 (version 2022.8) for analyzing microbiome datasets.
# It includes steps for importing, demultiplexing, quality control, feature table generation, filtering, and phylogenetic tree creation.
# Color codes for plots are specified as follows:

########################################
# YANOMAMI DATA WRANGLING
########################################

# Data downloaded from ENA: https://www.ebi.ac.uk/ena/browser/view/PRJEB7825

### Step 1: Import raw data ###
qiime tools import \
  --type EMPPairedEndSequences \
  --input-path Yanomami-paired-end-sequences \
  --output-path Yanomami-paired-end-sequences.qza

### Step 2: Demultiplexing ###
qiime demux emp-paired \
  --i-seqs Yanomami-paired-end-sequences.qza \
  --m-barcodes-file Yanomani_metadata.txt \
  --m-barcodes-column barcode \
  --p-rev-comp-barcodes False \
  --p-rev-comp-mapping-barcodes True \
  --o-per-sample-sequences Yanomani.qza \
  --o-error-correction-details Yanomani-details.qza

# Visualize demultiplexing summary
qiime demux summarize \
  --i-data Yanomani.qza \
  --o-visualization Yanomani.qzv

### Step 3: Quality filtering ###
qiime quality-filter q-score \
  --i-demux Yanomani.qza \
  --o-filtered-sequences Yanomani-filtered.qza \
  --o-filter-stats Yanomani-filter-stats.qza

### Step 4: Deblur denoising ###
qiime deblur denoise-16S \
  --i-demultiplexed-seqs Yanomani-filtered.qza \
  --p-trim-length 150 \
  --p-sample-stats \
  --o-representative-sequences Yanomami_rep-seqs-deblur.qza \
  --o-table Yanomani_table-deblur.qza \
  --o-stats Yanomani_deblur-stats.qza

# Visualize deblur stats
qiime metadata tabulate \
  --m-input-file Yanomani-filter-stats.qza \
  --o-visualization Yanomani_demux-filter-stats.qzv
qiime deblur visualize-stats \
  --i-deblur-stats Yanomani_deblur-stats.qza \
  --o-visualization Yanomani_deblur-stats.qzv

# Rename for consistency
mv Yanomani_rep-seqs-deblur.qza Yanomani_rep-seqs.qza
mv Yanomani_table-deblur.qza Yanomani_table.qza

### Step 5: Generate feature table ###
qiime feature-table summarize \
  --i-table Yanomani_table.qza \
  --o-visualization Yanomani_table.qzv \
  --m-sample-metadata-file Yanomani_metadata.txt

qiime feature-table tabulate-seqs \
  --i-data Yanomani_rep-seqs.qza \
  --o-visualization Yanomani_rep-seqs.qzv

### Step 6: Phylogenetic tree creation ###
qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences Yanomani_rep-seqs.qza \
  --output-dir Yanomani_phylogeny-align-to-tree-mafft-fasttree

### Step 7: Filtering by metadata ###
# Filter samples to include adults only
qiime feature-table filter-samples \
  --i-table Yanomani_table.qza \
  --m-metadata-file Yanomani_metadata.txt \
  --p-where '[adult_infant] IS "adult"' \
  --o-filtered-table Yanomani_Age_Filtered.qza

# Filter for human-oral samples only
qiime feature-table filter-samples \
  --i-table Yanomani_Age_Filtered.qza \
  --m-metadata-file Yanomani_metadata.txt \
  --p-where '[env_package] IS "human-oral"' \
  --o-filtered-table Yanomani_Saliva_Filtered.qza

# Remove singletons (features appearing in only one sample)
qiime feature-table filter-features \
  --i-table Yanomani_Saliva_Filtered.qza \
  --p-min-frequency 5 \
  --o-filtered-table table_no_singletons.qza

# Retain features present in at least 5 samples
qiime feature-table filter-features \
  --i-table table_no_singletons.qza \
  --p-min-samples 5 \
  --o-filtered-table Yanomami_final.qza

########################################
# TANZANIA DATA WRANGLING
########################################

# Data downloaded from ENA: https://www.ebi.ac.uk/ena/browser/view/PRJEB14941

### Step 1: Download and merge raw data ###
# Fetch sequencing run info
esearch -db sra -query "PRJEB14941" | efetch -format runinfo > Tanzania_runinfo.csv

# Download fastq files
while read -r SRR; do
  fastq-dump --split-3 "$SRR" > "$SRR"
done < Accession_number.txt

# Merge fastq files into one
cat *.fastq > Tanzania.fastq

### Step 2: Import into QIIME ###
qiime tools import \
  --type 'SampleData[SequencesWithQuality]' \
  --input-path Tanzania_copy \
  --input-format CasavaOneEightSingleLanePerSampleDirFmt \
  --output-path Tanzania_demux-single-end.qza

# Visualize demultiplexing summary
qiime demux summarize \
  --i-data Tanzania_demux-single-end.qza \
  --o-visualization Tanzania_demux.qzv

### Step 3: Quality filtering and denoising ###
qiime quality-filter q-score \
  --i-demux Tanzania_demux-single-end.qza \
  --o-filtered-sequences Tanzania_demux-filtered.qza \
  --o-filter-stats Tanzania_demux-filter-stats.qza

qiime deblur denoise-16S \
  --i-demultiplexed-seqs Tanzania_demux-filtered.qza \
  --p-trim-length 150 \
  --p-sample-stats \
  --o-representative-sequences Tanzania_rep-seqs-deblur.qza \
  --o-table Tanzania_table-deblur.qza \
  --o-stats Tanzania_deblur-stats.qza

# Generate and visualize feature table
qiime feature-table summarize \
  --i-table Tanzania_table-deblur.qza \
  --m-sample-metadata-file Tanzania_metadata.txt \
  --o-visualization Tanzania_table.qzv




